# ---------------------------------------------------------------------------
# THRIVE&CO - environment configuration
# Copy this file to ".env" and fill in your Neon credentials.
# ---------------------------------------------------------------------------

# HTTP port used by the Spring Boot server
PORT=8080

# Neon PostgreSQL connection
#
# In the Neon dashboard open "Connection Details" and copy the pooled
# connection string. It looks like:
#
#   postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
#
# Add the "jdbc:" prefix and keep sslmode=require. channel_binding=require is
# supported by the PostgreSQL JDBC driver and Neon; remove it only if your
# environment cannot negotiate SCRAM channel binding.
#
DB_URL=jdbc:postgresql://<your-neon-pooler-host>/neondb?sslmode=require&channel_binding=require
DB_USER=<your-neon-user>
DB_PASSWORD=<your-neon-password>

# To run with the embedded H2 database instead, use the local profile:
#   ./run.sh local
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
